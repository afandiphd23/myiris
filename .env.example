PORT=3001
NODE_ENV=development
# Login OpenSky (pilihan; kuota API jauh lebih tinggi daripada akses anonim).
# Daftar: akaun OpenSky → halaman Account → kad API Client.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Butang login Google (pilihan; daftar di Google Cloud Console → Credentials → OAuth client ID).
# Tanpa ini, butang login disembunyi dan app kekal mod tanpa nama.
VITE_GOOGLE_CLIENT_ID=
