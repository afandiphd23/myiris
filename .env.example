PORT=3001
NODE_ENV=development
# Login OpenSky (pilihan; kuota API jauh lebih tinggi daripada akses anonim).
# Daftar: akaun OpenSky → halaman Account → kad API Client.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Butang login Google (pilihan override; Client ID lalai sudah dibina dalam app).
# Daftar di Google Cloud Console → Credentials → OAuth client ID jika mahu guna ID sendiri.
VITE_GOOGLE_CLIENT_ID=
